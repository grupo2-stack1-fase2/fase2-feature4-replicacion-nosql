  <diagram id="feature4" name="4 - Replicacion asincrona a NoSQL">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="4 - Replicación asíncrona a NoSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bd" value="&lt;b&gt;Base de datos del monolito&lt;/b&gt;&lt;br&gt;MariaDB · oficina_agua_db&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(copia en Docker, puerto 3307)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E8E0C8;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="60" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="thread" value="&lt;b&gt;Thread&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SyncJobRunner · @Async&lt;br&gt;hilo sync-job-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8E0C8;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="355" y="250" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dynamo" value="Amazon&lt;br&gt;DynamoDB&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tabla resumen_cuentas&lt;br&gt;(1 documento por contador)&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#3B48CC;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="120" y="390" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="generarjob" value="&lt;b&gt;GenerarJob&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SyncJobService.crearJob()&lt;br&gt;job en memoria · 409 si hay uno activo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8E0C8;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="345" y="400" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="generate" value="&lt;b&gt;Generate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /api/sync/resumen&lt;br&gt;202 + jobId + verEn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#C6F2C6;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="630" y="400" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="partida" value="Punto de partida - Swagger&lt;br&gt;o botón &quot;Iniciar replicación&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="815" y="420" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="getjob" value="&lt;b&gt;GetJob&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET /api/sync/jobs/{jobId}&lt;br&gt;estado · progreso 0-100 % · resultados&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#C6F2C6;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="345" y="590" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pagina" value="&lt;b&gt;Página de progreso&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/progreso.html?jobId=...&lt;br&gt;barra + tabla de resultados en vivo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#C6F2C6;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="630" y="590" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="reglas" value="&lt;b&gt;Reglas del flujo&lt;/b&gt;&lt;br&gt;• El monolito no se modifica: solo se lee con el usuario sync_reader (permiso SELECT).&lt;br&gt;• Solo se escriben las diferencias: huella SHA-256 por contador.&lt;br&gt;• Nunca se borra en DynamoDB (putItem, nunca deleteItem).&lt;br&gt;• Un job a la vez: si hay uno activo, el POST responde 409.&lt;br&gt;• Todo corre con docker compose: MariaDB, DynamoDB Local, DynamoDB Admin y sync-service (puerto 8084)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=4;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="60" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="e_thread_bd" value="1. lee el resumen de cada contador&lt;br&gt;SELECT · usuario sync_reader (solo lectura)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="thread" target="bd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_thread_dynamo" value="2. compara la huella SHA-256&lt;br&gt;3. putItem solo si cambió&lt;br&gt;(nunca borra)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;exitX=0;exitY=0.5;" edge="1" parent="1" source="thread" target="dynamo">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="159" y="290" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_job_thread" value="lanza el hilo&lt;br&gt;(@Async)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;exitX=0.35;exitY=0;entryX=0.35;entryY=1;labelPosition=left;align=right;" edge="1" parent="1" source="generarjob" target="thread">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_thread_job" value="4. registra el avance&lt;br&gt;y el resultado de cada contador" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#666666;fontSize=10;exitX=0.7;exitY=1;entryX=0.7;entryY=0;labelPosition=right;align=left;" edge="1" parent="1" source="thread" target="generarjob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_generate_job" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="generate" target="generarjob">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="715" y="530" /><mxPoint x="430" y="530" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_getjob_job" value="&lt;b&gt;Get Job / Response Job&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;labelPosition=right;align=left;spacingLeft=6;" edge="1" parent="1" source="getjob" target="generarjob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pagina_getjob" value="consulta cada 1 s&lt;br&gt;(polling)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="pagina" target="getjob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="DynamoDB Admin&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;visor web · puerto 8001&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="600" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_admin" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#999999;fontSize=10;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="admin" target="dynamo">
          <mxGeometry relative="1" as="geometry">
